{
  "slug": "yutoku-inari-ariake",
  "heroCheckpointId": "section-1",
  "checkpointsTitle": "コースの雰囲気",
  "intro": "JR肥前浜駅付近から肥前浜宿を通り、祐徳稲荷神社の参道、大魚神社海中鳥居の岸側を経てJR多良駅前へ向かう約17.6kmの参考ルートです。町中の一般道や海沿いをつなぎ、祐徳稲荷周辺では起伏があります。参道は参拝者を優先して歩いて通過してください。潮位で水没する海中道路への往復は含めず、海中鳥居は岸側から景色を楽しむ立ち寄り地点としています。",
  "warnings": [
    {
      "title": "参道では歩いて通過してください",
      "body": "祐徳稲荷神社の参道は参拝者を優先し、混雑時は無理に進まず現地案内に従ってください。",
      "url": "https://www.yutokusan.jp/",
      "linkLabel": "祐徳稲荷神社の公式案内"
    },
    {
      "title": "海中道路への往復は含みません",
      "body": "潮位によって水没する海中道路への往復は、この参考ルートから除いています。水に覆われた道路へ進まず、岸側から景色を楽しんでください。海中鳥居周辺では漁業作業と現地案内を優先してください。",
      "url": "https://www.town.tara.lg.jp/kanko/_1901/_4175.html",
      "linkLabel": "太良町の海中鳥居案内"
    },
    {
      "title": "漁業作業にご配慮ください",
      "body": "太良町の2026年9月10日更新案内では、海中鳥居周辺の漁業作業期間を4月上旬〜下旬、9月4日〜10月末頃としています。観光と駐車場は通常どおり利用できますが、作業の妨げにならないよう現地案内に従ってください。",
      "url": "https://www.town.tara.lg.jp/kanko/_1901/_4175.html",
      "linkLabel": "太良町の最新案内"
    }
