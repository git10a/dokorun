{
  "slug": "okumusashi-izugatake",
  "heroCheckpointId": "section-1",
  "checkpointsTitle": "コースの雰囲気",
  "intro": "正丸駅を起点に、正丸峠から伊豆ヶ岳、古御岳、高畑山、天目指峠、子ノ権現をつなぎ、西吾野方面から戻る約16.2kmの参考周回です。舗装路と登山道を含み、尾根には急な登り下りがあります。伊豆ヶ岳北側は男坂と閉道の女坂を避け、両坂の間の正式な迂回路を通ります。山道では歩行者を優先し、急坂や岩場は歩いて進んでください。",
  "warnings": [
    {
      "title": "伊豆ヶ岳北側は正式な迂回路へ",
      "body": "伊豆ヶ岳北側の男坂は滑落・落石の危険があり利用しません。女坂も閉道のため、両坂の間にある正式な迂回路と現地標識に従ってください。山道では歩行者を優先し、急坂や岩場は歩いて通過してください。",
      "url": "https://www.pref.saitama.lg.jp/b0502/sizennkouenn23/izugatakewokoeru.html",
      "linkLabel": "埼玉県の最新コース案内"
    },
    {
      "title": "天候と現地の通行情報を確認してください",
      "body": "自然路は天候や季節で路面・通行状況が変わります。最新の警報、現地の規制、日没時刻を確認し、無理のない装備と計画で利用してください。",
      "url": "https://www.env.go.jp/nature/nationalparks/pick-up/long-trail/beginner/",
      "linkLabel": "環境省の自然歩道初心者ガイド"
    },
    {
      "title": "コースデータは出発前にも確認してください",
      "body": "アクセス情報: 西武秩父線正丸駅すぐ 工事や災害、施設の営業時間などは変わるため、現地案内を優先してください。",
      "url": "https://dokorun.com/guide/gpx",
      "linkLabel": "ウォッチ・アプリへの取り込みガイド"
    }
